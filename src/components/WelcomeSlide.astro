---
import Header from "./Header.astro"
import PillImage from "../assets/pills.jpg"
import { getImage } from 'astro:assets';
const background_img = await getImage({src: PillImage})
import type { HTMLAttributes } from 'astro/types';
type Props = HTMLAttributes<'a'>;
const { href, class: className, ...props } = Astro.props;
import "../styles/global.css"
---

<div class="h-dvh max-h-dvh flex flex-col justify-start" style={`background-image: url(${background_img.src}); background-size: cover;`}>
	<Header />
	<div class="flex-1 min-h-0">
		<slot />
	</div>
</div>
