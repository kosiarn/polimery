
---
import WelcomeSlide from "../../../components/WelcomeSlide.astro"
import RegularSlide from "../../../components/RegularSlide.astro"
import BaseHead from "../../../components/BaseHead.astro"
import Avatar from "../../../components/Avatar.jsx"
import SectionTitleBar from "../../../components/SectionTitleBar.astro"
import { getCollection } from "astro:content"
import { getLangFromURL, useTranslations } from "../../../i18n/utils"

const lang = getLangFromURL(Astro.url);
const t = useTranslations(lang);
const supervisor = await getCollection('personnel', ({data, id}) => { return data.position == 'Kierownik' && id.includes(lang)})
const scientific_staff = await getCollection('personnel', ({data, id}) => { return data.group == 'Science' && id.includes(lang)})
const technical_staff = await getCollection('personnel', ({data, id}) => { return data.group == 'Technical' && id.includes(lang)})
const expert_staff = await getCollection('personnel', ({data, id}) => { return data.group == 'Expert' && id.includes(lang)})

---
	<head>
		<BaseHead title={t("page.team.title")} description="" />
	</head>
	<body>
		<WelcomeSlide>
			<div class="w-full h-full flex flex-row justify-center items-center">
				<div class="w-max-[1400px] md:h-max-[716px] w-[72%] h-auto bg-managerblue/50 flex flex-col py-[16px] px-[37px] md:py-[28px]">
					<h1 class="font-display text-center text-[30px] md:text-[36px] p-[8px] md:p-0 w-full">{t("title.supervisor")}</h1>
					<div class="w-full h-full flex flex-col md:flex-row items-center md:gap-[24px]">
						<Avatar personnelPageLink={ `/${lang}/personnel/${supervisor[0].id.replace( lang + "/", "")}`} avatarLink={supervisor[0].data.avatar_link} name={supervisor[0].data.name_surname} />
							<div class="flex flex-col md:flex-row w-full items-center justify-between my-[16px] 2xl:my-0">
								<div class="h-auto w-fit flex flex-col items-center justify-center px-[8px]">
									<p class="font-regular lg:text-left text-[16px] lg:text-[36px] w-full text-center">{supervisor[0].data.title}</p>
									<h1 class="font-regular text-[32px] lg:text-[64px] text-center">{supervisor[0].data.name_surname}</h1>
								</div>
								<div style="border-left:1px solid #000;height:160px" class="invisible 2xl:visible"></div>
								<div class="hidden 2xl:flex flex-col items-center justify-center px-[12px] ">
									<p class="font-regular text-[36px] w-full text-left">ORCID: {supervisor[0].data.orc_id}</p>
									<p class="font-regular text-[36px] w-full text-left">Researcher ID: {supervisor[0].data.researcher_id}</p>
									{supervisor[0].data.google_scholar && <a href={supervisor[0].data.google_scholar} class="font-regular text-[36px] underline w-full text-left">Google Scholar</a>}
								</div>
							</div>
					</div>
				</div>
			</div>
		</WelcomeSlide>
		<RegularSlide>
			{scientific_staff.length > 0 && (<SectionTitleBar text={t("page.team.science")} />
			<div class="w-full flex flex-row justify-center flex-wrap gap-[64px] p-[16px] md:p-[64px]">
				{scientific_staff.map((researcher) => <Avatar personnelPageLink={ `/${lang}/personnel/${researcher.id.replace( lang + "/", "")}`} name={researcher.data.name_surname} title={researcher.data.title} showNameCard={true} avatarLink={researcher.data.avatar_link} role={researcher.data.role}/>)}
			</div>)
			}
			{technical_staff.length > 0 && (<SectionTitleBar text={t("page.team.technical")} />
			<div class="w-full flex flex-row justify-center flex-wrap gap-[64px] p-[16px] md:p-[64px]">
				{technical_staff.map((researcher) => <Avatar personnelPageLink={ `/${lang}/personnel/${researcher.id.replace( lang + "/", "")}`} name={researcher.data.name_surname} title={researcher.data.title} showNameCard={true} avatarLink={researcher.data.avatar_link} role={researcher.data.role}/>)}
			</div>)
			}
			{expert_staff.length > 0 && (<SectionTitleBar text={t("page.team.experts")} />
			<div class="w-full flex flex-row justify-center flex-wrap gap-[64px] p-[16px] md:p-[64px]">
				{expert_staff.map((expert) => <Avatar personnelPageLink={ `/${lang}/personnel/${expert.id.replace( lang + "/", "")}`} name={expert.data.name_surname} title={expert.data.title} showNameCard={true} avatarLink={expert.data.avatar_link} role={expert.data.role}/>)}
			</div>)
			}
		</RegularSlide>
	</body>
